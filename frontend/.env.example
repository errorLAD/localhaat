# ==============================================================
# LocalHaat Frontend Environment Configuration
# Brand: LocalHaat | Legal: InfraBlue Material Technologies Private Limited
# ==============================================================

# Public LocalHaat API URL (Vercel / Production / Staging)
NEXT_PUBLIC_API_URL=https://api.localhaat.in/api

# Real-time WebSocket Gateway URL
NEXT_PUBLIC_SOCKET_URL=https://api.localhaat.in

# Canonical Domain URL (Must be https://localhaat.in in production)
NEXT_PUBLIC_SITE_URL=https://localhaat.in

# Analytics & Digital Marketing Tracking
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion Tag ID (e.g. AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Google Search Console Verification Token
GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

# (Optional) Internal Backend Proxy URL for Next.js rewrites
BACKEND_INTERNAL_URL=https://api.localhaat.in
