# ==============================================================
# LocalHaat Backend Environment Configuration
# Brand: LocalHaat | Legal: InfraBlue Material Technologies Private Limited
# ==============================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database (MongoDB connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/localhaat?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=https://localhaat.in

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Maps & Geocoding (Google Maps API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloud Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Fallback Settings
USE_IN_MEMORY_DB_IF_LOCAL_FAILS=false
